{
  "schema_version": "kit-v1", "name": "genome-identity", "version": "0.1.0",
  "core_version": {"minimum": "2.2.5", "maximum_exclusive": "3.0.0"},
  "input_schema": {
    "type": "object", "additionalProperties": false, "required": ["request_file", "context_file"],
    "properties": {
      "request_file": {"type": "string", "minLength": 1}, "context_file": {"type": "string", "minLength": 1},
      "language": {"enum": ["zh", "en"]}, "trace_mode": {"enum": ["normal", "strict"]}
    },
    "definitions": {"request": {
      "type": "object", "additionalProperties": false, "required": ["original_request"],
      "properties": {
        "kit": {"const": "identity"}, "title": {"type": "string"},
        "original_request": {"type": "string", "minLength": 1}, "decisions": {"type": "array"},
        "references": {"type": "array", "items": {"type": "string"}}, "compare_regions": {"type": "boolean"},
        "alignment_mode": {"enum": ["local", "global"]}, "assays": {"type": "array"}, "design_assays": {"type": "array"}
      }
    }}
  },
  "input_example": {"request_file": "examples/request.json", "context_file": "examples/context.json", "language": "en"},
  "entrypoint": "scripts/entry.py:run",
  "outputs": {"contract": "json-object", "files": ["result.json", "context-snapshot.json", "summary.md", "TOOLKIT-RECEIPT.json"]},
  "contributions": [{
    "target": "tools", "name": "assess", "description": "Assess supplied-region alignment/PCR/full-oligo quality using the unchanged analytical workflow.",
    "source": "README.md#scope-and-sources; original scoped workflow and independent positive/negative regression inputs.",
    "content": {
      "entrypoint": "scripts/entry.py:assess", "category": "inspect",
      "parameters_schema": {"type": "object", "properties": {"request": {"type": "object"}, "context_uri": {"type": "string", "format": "uri"}}}
    }
  }]
}
