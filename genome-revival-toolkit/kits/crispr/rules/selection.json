{
  "schema_version": "1.0.0",
  "rules": [
    {
      "id": "selection-amp",
      "name": "Conditional selection for amp",
      "version": 1,
      "status": "active",
      "trigger": "before_culture_plan",
      "scope": {
        "type": "project",
        "project_id": "genome-crispr"
      },
      "when": {
        "field": "marker_id",
        "operator": "eq",
        "value": "amp"
      },
      "action": {
        "type": "set_default",
        "field": "selection_mapping",
        "value": {
          "marker_id": "amp",
          "pattern": "ampr|ampicillin|bla(?:tem\\d*)?|beta-lactamase",
          "hosts": {
            "ecoli": [
              "LB + ampicillin",
              "NEB"
            ]
          },
          "auxotrophy": null,
          "sources": {
            "NEB": {
              "source_type": "manufacturer",
              "name": "NEB Turbo competent E. coli: antibiotics for plasmid selection",
              "url": "https://www.neb.com/en-us/products/c2986-neb-turbo-electrocompetent-e-coli",
              "retrieved_at": "2026-10-14",
              "verification_status": "verified"
            }
          }
        }
      },
      "source": {
        "type": "manufacturer",
        "description": "NEB Turbo competent E. coli: antibiotics for plasmid selection",
        "url": "https://www.neb.com/en-us/products/c2986-neb-turbo-electrocompetent-e-coli",
        "host_sources": [
          {
            "host": "ecoli",
            "source_type": "manufacturer",
            "name": "NEB Turbo competent E. coli: antibiotics for plasmid selection",
            "url": "https://www.neb.com/en-us/products/c2986-neb-turbo-electrocompetent-e-coli",
            "retrieved_at": "2026-10-14",
            "verification_status": "verified"
          }
        ]
      }
    },
