{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snapgene-dna-design:schema:assembly-plan-v0.9",
  "title": "Assembly plan v0.9",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "goal", "construct_name", "status",
               "sources", "fragment_assignments", "assembly_strategy",
               "primers", "feasibility", "final_construct", "execution",
               "provenance"],
  "properties": {
    "schema_version": {"const": "0.9.0"},
    "goal": {"type": "string"},
    "construct_name": {"type": "string"},
    "status": {"enum": ["complete", "blocked"]},
    "sources": {"type": "array"},
    "fragment_assignments": {"type": "array", "minItems": 1,
      "items": {"type": "object",
                "required": ["name", "role", "source_index",
                             "source_interval_0based", "length", "sequence"]}},
    "assembly_strategy": {"type": "object",
      "required": ["method", "reason", "alternatives"]},
    "primers": {"type": "array"},
    "feasibility": {"type": "object",
      "required": ["grade", "errors", "warnings"]},
    "final_construct": {"type": "object",
      "required": ["status", "length", "sequence", "gc_percent",
                   "sequence_note", "executor", "feature_specs"],
      "properties": {
        "status": {"enum": ["validated", "not_available"]},
        "length": {"type": "integer", "minimum": 0},
        "sequence": {"type": ["string", "null"]},
        "gc_percent": {"type": ["number", "null"]},
        "sequence_note": {"type": "string"},
        "executor": {"type": ["string", "null"]},
        "feature_specs": {"type": "array"}
      }},
    "execution": {"type": "object",
      "required": ["status", "reason", "executor", "feature_specs"],
      "properties": {
        "status": {"enum": ["validated", "not_attempted", "failed"]},
        "reason": {"type": ["string", "null"]},
        "executor": {"type": ["string", "null"]},
        "feature_specs": {"type": "array"}
      }},
    "provenance": {"type": "array", "minItems": 1}
  }
}
