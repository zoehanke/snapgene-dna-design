{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snapgene-dna-design:schema:provenance-v0.8",
  "title": "Provenance source v0.8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_type",
    "name",
    "role",
    "status"
  ],
  "properties": {
    "source_type": {
      "enum": [
        "software",
        "prediction-model",
        "reference-database",
        "manufacturer-protocol",
        "public-protocol",
        "published-paper",
        "heuristic",
        "user-input"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "verified",
        "partial",
        "unavailable",
        "unknown",
        "conflicting",
        "stale"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification": {
      "type": [
        "object",
        "null"
      ]
    },
    "retrieved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "catalog_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "applicable_to": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "manufacturer-protocol"
          }
        },
        "required": [
          "source_type"
        ]
      },
      "then": {
        "required": [
          "url",
          "retrieved_at",
          "version"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "prediction-model"
          }
        },
        "required": [
          "source_type"
        ]
      },
      "then": {
        "required": [
          "version"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "public-protocol"
          }
        },
        "required": [
          "url",
          "retrieved_at"
        ]
      }
    }
  ]
}
