{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snapgene-dna-design:schema:protocol-recommendation-v0.8",
  "title": "Protocol recommendation v0.8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "recommendations",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.8.0"
    },
    "status": {
      "enum": [
        "available",
        "partial",
        "unavailable",
        "conflicting"
      ]
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provenance"
      }
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendation_id",
        "reaction_id",
        "category",
        "status",
        "source",
        "evidence_level",
        "human_review_required"
      ],
      "properties": {
        "recommendation_id": {
          "type": "string",
          "minLength": 1
        },
        "reaction_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string"
        },
        "recommended_system": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "preferred_candidate",
            "compatible_candidate",
            "not_recommended",
            "insufficient_evidence",
            "conflicting_sources"
          ]
        },
        "match_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": [
            "object",
            "null"
          ]
        },
        "evidence_level": {
          "type": "string"
        },
        "human_review_required": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "name",
        "role",
        "status"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "software",
            "prediction-model",
            "reference-database",
            "manufacturer-protocol",
            "public-protocol",
            "published-paper",
            "heuristic",
            "user-input"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "verified",
            "partial",
            "unavailable",
            "unknown",
            "conflicting",
            "stale"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification": {
          "type": [
            "object",
            "null"
          ]
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "catalog_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "applicable_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "manufacturer-protocol"
              }
            },
            "required": [
              "source_type"
            ]
          },
          "then": {
            "required": [
              "url",
              "retrieved_at",
              "version"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "prediction-model"
              }
            },
            "required": [
              "source_type"
            ]
          },
          "then": {
            "required": [
              "version"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "public-protocol"
              }
            },
            "required": [
              "url",
              "retrieved_at"
            ]
          }
        }
      ]
    }
  }
}
